# ------------------------------------------------------------------
# ウィッシュリスト予算マネージャー — 環境変数サンプル
# このファイルを .env.local にコピーして値を設定してください。
# ------------------------------------------------------------------

# 【本番/クラウド同期に必須】Supabase Postgres の接続文字列
# Supabase ダッシュボード → Project Settings → Database → Connection string →
# 「Transaction pooler」(ポート 6543) の URI をそのまま貼り付けます。
# 例: postgres://postgres.xxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
#
# ※ 未設定の場合は、ローカルの JSON ファイル(.data/wishlist.json)に保存されます
#    （ローカル開発用。Vercel 本番では必ず設定してください）。
DATABASE_URL=

# 【任意】アプリにパスワードロックをかけたい場合に設定します。
# 設定すると /login でこのパスワードを要求します。未設定なら認証なし（URL を知る人は誰でも閲覧可）。
# 個人の購入データを守るため、公開デプロイでは設定を推奨します。
APP_PASSWORD=

# 【推奨・Vercel 本番】キープアライブ用の秘密の文字列（任意の長いランダム文字列）。
# 設定すると、Vercel Cron が毎日 /api/keepalive を呼んで DB に軽いクエリを投げ、
# Supabase 無料プランの「放置による自動停止」を避けやすくします（確実ではありません）。
# 未設定の場合、/api/keepalive は常に 401 を返します。
CRON_SECRET=
